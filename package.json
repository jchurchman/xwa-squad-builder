{
  "name": "xwa-squad-builder",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "test": "npm run client:test && npm run backend:test",
    "dev": "concurrently \"npm run backend:dev\" \"npm run client:dev\"",
    "backend:dev": "cd backend && go run ./cmd/server",
    "backend:import": "cd backend && go run ./cmd/importcards",
    "backend:test": "cd backend && go vet ./... && go test ./...",
    "generate": "buf lint && buf generate",
    "build": "npm run client:build && npm run backend:build",
    "start": "cd backend && ./bin/server",
    "backend:build": "cd backend && go build -o bin/server ./cmd/server",
    "server:dev": "npm run dev --workspace=server",
    "server:build": "npm run build --workspace=server",
    "server:start": "npm run start --workspace=server",
    "client:dev": "npm run dev --workspace=client",
    "client:build": "npm run build --workspace=client",
    "client:test": "npm run test --workspace=client"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-perfectionist": "^4.14.0",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.5.3",
    "prettier-plugin-sort-json": "^4.1.1",
    "typescript-eslint": "^8.33.1"
  }
}
